<div class="min-h-screen flex items-start justify-center p-4 pt-8 pb-28 sm:p-8 sm:pt-16 sm:pb-32">
  <div class="w-full max-w-2xl">

    <% if notice.present? %>
      <div class="rounded-2xl bg-emerald-50 border border-emerald-200 px-5 py-4 text-sm text-emerald-700 mb-6">
        <%= notice %>
      </div>
    <% end %>

    <h1 class="text-2xl font-bold text-gray-900 font-barlow text-center mb-6">
      <%= @competition.name %>
    </h1>

    <%# Rounds %>
    <% if @competition.scaffold_generated? %>
      <h2 class="text-sm font-semibold text-gray-900 font-barlow mb-4">Rounds</h2>
      <% round_count = 1 %>
      <% @competition.rounds.order(:id).each do |round| %>
        <div class="bg-white rounded-2xl border border-gray-200 mb-3 overflow-hidden">

          <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
            <div>
              <h3 class="text-sm font-semibold text-gray-900">Round <%= round_count %></h3>
              <% if round.name.present? %>
                <p class="text-xs text-gray-400 mt-0.5"><%= round.name %></p>
              <% end %>
            </div>
          </div>

          <div class="divide-y divide-gray-100">
            <% round.games.each do |game| %>
              <div class="flex items-center justify-between px-5 py-4">

                <%# Team 1 %>
                <div class="flex items-center gap-2 flex-1">
                  <% if game.team_1&.logo&.attached? %>
                    <%= image_tag game.team_1.logo, class: "w-9 h-9 rounded-lg object-cover border border-gray-200" %>
                  <% else %>
                    <div class="w-9 h-9 rounded-lg bg-gray-100 flex-shrink-0"></div>
                  <% end %>
                  <span class="text-sm font-medium text-gray-900"><%= game.team_1&.name || "TBD" %></span>
                </div>

                <%# vs %>
                <span class="text-xs text-gray-300 mx-1 sm:mx-3">vs</span>

                <%# Team 2 %>
                <div class="flex items-center gap-2 flex-1 justify-end">
                  <span class="text-sm font-medium text-gray-900"><%= game.bye? ? "BYE" : (game.team_2&.name || "TBD") %></span>
                  <% if game.team_2&.logo&.attached? %>
                    <%= image_tag game.team_2.logo, class: "w-9 h-9 rounded-lg object-cover border border-gray-200" %>
                  <% else %>
                    <div class="w-9 h-9 rounded-lg bg-gray-100 flex-shrink-0"></div>
                  <% end %>
                </div>

                <%# View game %>
                <%= link_to game_path(game), class: "ml-4 text-xs font-medium text-emerald-600 hover:text-emerald-700 transition-colors flex-shrink-0" do %>
                  View ›
                <% end %>

              </div>
            <% end %>
          </div>

        </div>
        <% round_count += 1 %>
      <% end %>
    <% end %>

  </div>
</div>

<%# Fixed bottom nav bar %>
<div class="fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-gray-200 px-4 py-3 sm:px-6 sm:py-4">
  <div class="mx-auto max-w-2xl flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-center">
    <%= link_to competition_path(@competition), class: "w-full sm:w-auto text-center rounded-xl px-4 py-2.5 text-sm font-medium bg-gray-100 text-gray-900 hover:bg-gray-200 transition-colors" do %>
      Back to competition
    <% end %>
    <% if current_user.admin? %>
      <%= link_to admin_competition_path(@competition), class: "w-full sm:w-auto text-center rounded-xl px-4 py-2.5 text-sm font-medium bg-gray-100 text-gray-900 hover:bg-gray-200 transition-colors" do %>
        Edit rounds
      <% end %>
    <% end %>
  </div>
</div>
