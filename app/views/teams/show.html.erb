<div class="min-h-screen flex items-start justify-center pt-16 p-8 pb-32">
  <div class="w-full max-w-2xl">

    <%# Team header card %>
    <div class="bg-white rounded-2xl border border-gray-200 p-6 mb-6 flex flex-col items-center">
      <% if @team.logo.attached? %>
        <%= image_tag @team.logo, class: "w-20 h-20 rounded-full object-cover mb-3" %>
      <% else %>
        <div class="w-20 h-20 rounded-full bg-gray-100 flex items-center justify-center text-2xl mb-3">
          🏆
        </div>
      <% end %>
      <h1 class="text-2xl font-bold text-gray-900 font-barlow"><%= @team.name %></h1>

      <% if @team.jersey.attached? %>
        <div class="mt-4 flex flex-col items-center">
          <%= image_tag @team.jersey.variant(resize_to_fit: [120, 120]), class: "w-20 h-20 object-cover rounded-xl border border-gray-200" %>
          <p class="text-xs text-gray-400 mt-1">Team jersey</p>
        </div>
      <% end %>
    </div>

    <%# Team members %>
    <div class="bg-white rounded-2xl border border-gray-200 p-6 mb-6">
      <h2 class="text-sm font-semibold text-gray-900 font-barlow mb-4">Team members</h2>
      <%= render "shared/team_member_card", team_members: @team_members %>
    </div>

    <%# Captain controls %>
    <% if current_user&.is_captain_of?(@team) %>

      <div class="bg-white rounded-2xl border border-gray-200 p-6 mb-6">
        <p class="text-xs text-gray-400 uppercase tracking-wider mb-2">Captain</p>
        <%= link_to edit_team_path(@team), class: "flex items-center justify-between w-full text-sm font-medium text-gray-900 hover:text-emerald-700 py-3 transition-colors" do %>
          Edit team
          <span class="text-gray-300">›</span>
        <% end %>
      </div>

      <%# Add existing user %>
      <div class="bg-white rounded-2xl border border-gray-200 p-6 mb-6">
        <h2 class="text-sm font-semibold text-gray-900 font-barlow mb-4">Add existing user</h2>
        <%= simple_form_for @team_member, url: add_member_team_path(@team), method: :post do |f| %>
          <div class="space-y-4">
            <% if @users.any? %>
              <%= f.association :user,
                  collection: @users,
                  label_method: :list_name,
                  prompt: "Select a user",
                  label_html: { class: "block text-sm font-medium text-gray-900" },
                  input_html: { class: "block w-full rounded-xl border border-gray-200 bg-white px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 sm:text-sm" },
                  wrapper_html: { class: "space-y-1" } %>
            <% else %>
              <p class="text-sm text-gray-400">No users available to invite.</p>
            <% end %>
            <%= f.button :submit, "Add to team",
                class: "flex w-full justify-center rounded-xl bg-emerald-600 px-3 py-2 text-sm font-semibold text-white hover:bg-emerald-500 cursor-pointer transition-colors",
                data: { confirm: "Are you sure you want to add this user to the team?" } %>
          </div>
        <% end %>
      </div>

      <%# Invite new user %>
      <div class="bg-white rounded-2xl border border-gray-200 p-6 mb-6">
        <h2 class="text-sm font-semibold text-gray-900 font-barlow mb-4">Invite new user by email</h2>
        <%= simple_form_for :team_invitation, url: send_invite_team_path(@team), method: :post do |f| %>
          <div class="space-y-4">
            <%= f.input :invitee_email,
                label: "Email",
                required: true,
                input_html: { type: "email", class: "block w-full rounded-xl border border-gray-200 bg-white px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 sm:text-sm" },
                label_html: { class: "block text-sm font-medium text-gray-900" },
                wrapper_html: { class: "space-y-1" } %>
            <%= f.button :submit, "Send invitation",
                class: "flex w-full justify-center rounded-xl bg-emerald-600 px-3 py-2 text-sm font-semibold text-white hover:bg-emerald-500 cursor-pointer transition-colors" %>
          </div>
        <% end %>
      </div>

    <% end %>

    <%# Team stats %>
    <div class="bg-white rounded-2xl border border-gray-200 p-6 mb-6">
      <%= render "shared/statscard", top_stats: @team.stats_summary.transform_keys(&:to_s).transform_values { |v| { team: @team, value: v } }, title: "Team Stats", team: @team, show_user: false %>
    </div>

    <%# Next game %>
    <div class="bg-white rounded-2xl border border-gray-200 p-6 mb-6">
      <h2 class="text-sm font-semibold text-gray-900 font-barlow mb-4">Next game</h2>
      <% if @team.next_game %>
        <%= render "shared/matchcard", game: @team.next_game %>
        <%= link_to game_path(@team.next_game.id), class: "flex items-center justify-between w-full text-sm font-medium text-gray-900 hover:text-emerald-700 py-3 border-t border-gray-100 mt-4 transition-colors" do %>
          View game
          <span class="text-gray-300">›</span>
        <% end %>
      <% else %>
        <p class="text-sm text-gray-400">No upcoming games scheduled.</p>
      <% end %>
    </div>

    <%# Player avatar %>
    <% if user_signed_in? %>
      <% current_member = @team.team_members.find_by(user: current_user) %>
      <% if current_member %>

        <div class="bg-white rounded-2xl border border-gray-200 p-6 mb-6">
          <h2 class="text-sm font-semibold text-gray-900 font-barlow mb-4">Your avatar for <%= @team.name %></h2>

          <div class="flex flex-wrap gap-4 mb-4">
            <% TeamAvatar.where(user: current_user, team: @team).order(created_at: :desc).limit(8).each do |ta| %>
              <% selected = current_user.avatar.attached? && current_user.avatar.blob_id == ta.blob_id %>
              <div class="flex flex-col items-center gap-1">
                <%= button_to set_avatar_path(ta.blob_id), method: :post, class: "border-none bg-transparent p-0 cursor-pointer" do %>
                  <%= image_tag rails_blob_path(ta.blob, disposition: "inline"),
                      width: 80, height: 80,
                      class: "rounded-full object-cover",
                      style: "border: 3px solid #{selected ? '#059669' : '#e5e7eb'};" %>
                <% end %>
                <span class="text-xs text-gray-400"><%= selected ? "Current" : "Use this" %></span>
                <%= button_to delete_ai_avatar_path(ta.blob_id),
                    method: :delete,
                    data: { turbo_confirm: "Delete this avatar?" },
                    class: "text-xs text-red-500 hover:text-red-700 bg-transparent border-none cursor-pointer transition-colors" do %>
                  Delete
                <% end %>
              </div>
            <% end %>
          </div>

          <% if !current_user.avatar.attached? %>
            <p class="text-xs text-gray-400">Upload a profile photo in <%= link_to "account settings", edit_user_registration_path, class: "underline hover:text-gray-700" %> to generate an avatar.</p>
          <% elsif !@team.jersey.attached? %>
            <p class="text-xs text-gray-400">Waiting for the captain to upload a team jersey.</p>
          <% else %>
            <%= button_to "Generate my #{@team.name} avatar",
                generate_ai_avatar_users_path,
                method: :post,
                params: { team_id: @team.id },
                class: "flex w-full justify-center rounded-xl bg-emerald-600 px-3 py-2 text-sm font-semibold text-white hover:bg-emerald-500 cursor-pointer transition-colors",
                data: { turbo_submits_with: "Generating your #{@team.name} avatar, please wait... this takes ~20 seconds" } %>
          <% end %>
        </div>

        <%# Kit display %>
        <% if @team.logo.attached? || @team.jersey.attached? %>
          <div class="bg-white rounded-2xl border border-gray-200 p-6 mb-6">
            <h2 class="text-sm font-semibold text-gray-900 font-barlow mb-4"><%= @team.name %> kit</h2>
            <div class="flex gap-6 flex-wrap">
              <% if @team.logo.attached? %>
                <div class="flex flex-col items-center gap-1">
                  <%= image_tag @team.logo, width: 80, class: "rounded-xl border border-gray-200" %>
                  <p class="text-xs text-gray-400">Team logo</p>
                </div>
              <% end %>
              <% if @team.jersey.attached? %>
                <div class="flex flex-col items-center gap-1">
                  <%= image_tag @team.jersey, width: 80, class: "rounded-xl border border-gray-200" %>
                  <p class="text-xs text-gray-400">Team jersey</p>
                </div>
              <% end %>
            </div>
            <% if current_user&.is_captain_of?(@team) %>
              <%= link_to edit_team_path(@team), class: "flex items-center justify-between w-full text-sm font-medium text-gray-900 hover:text-emerald-700 py-3 border-t border-gray-100 mt-4 transition-colors" do %>
                Manage team logo and jersey
                <span class="text-gray-300">›</span>
              <% end %>
            <% end %>
          </div>
        <% end %>

      <% end %>
    <% end %>

  </div>
</div>

<%# Fixed bottom nav bar %>
<div class="fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-gray-200 px-6 py-4">
  <div class="mx-auto max-w-2xl flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-center">
    <%= link_to teams_path, class: "w-full sm:w-auto text-center rounded-xl px-4 py-2.5 text-sm font-medium bg-gray-100 text-gray-900 hover:bg-gray-200 transition-colors" do %>
      Back to teams
    <% end %>
  </div>
</div>

<%# Invitation popup %>
<% if @invitation_token.present? && @invitation.present? %>
  <div data-controller="team-popup"
       data-team-popup-token-value="<%= @invitation_token %>"
       data-team-popup-accept-url-value="<%= team_invitation_accept_path(@invitation) %>"
       data-team-popup-reject-url-value="<%= team_invitation_reject_path(@invitation) %>"
       data-team-popup-team-name-value="<%= @team.name %>"
       class="fixed inset-0 bg-black/50 flex items-center justify-center z-[9999]">
    <div class="bg-white rounded-2xl border border-gray-200 p-6 max-w-sm w-full mx-4">
      <h2 class="text-base font-semibold text-gray-900 mb-2">Accept invitation?</h2>
      <p class="text-sm text-gray-500 mb-6">You've been invited to join <span class="font-medium text-gray-900"><%= @team.name %></span></p>
      <div class="flex gap-3">
        <button data-action="click->team-popup#acceptInvitation"
                class="flex-1 rounded-xl bg-emerald-600 text-white text-sm font-semibold px-4 py-2.5 hover:bg-emerald-500 cursor-pointer transition-colors">
          Accept
        </button>
        <button data-action="click->team-popup#rejectInvitation"
                class="flex-1 rounded-xl bg-red-500 text-white text-sm font-semibold px-4 py-2.5 hover:bg-red-600 cursor-pointer transition-colors">
          Decline
        </button>
      </div>
    </div>
  </div>
<% end %>
