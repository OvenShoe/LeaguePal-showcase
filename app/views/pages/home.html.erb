<nav class="font-barlowlight my-4 p-2">
  <ul class="grid grid-cols-3 text-center w-full">
    <li class="hover:font-bold"><%= link_to "Competitions", competitions_path %></li>
    <% unless current_user&.role == "Admin" %>
      <li class="hover:font-bold"><%= link_to "Trophies", trophies_path %></li>
    <% end %>
    <li class="hover:font-bold"><%= link_to "Users", users_path %></li>
  </ul>
</nav>

<% if user_signed_in? %>
  <p>Signed in as <%= current_user.email %></p>
  <p>
    <%= link_to "Edit Profile", edit_user_path(current_user) %> |
    <%= link_to "Log Out", destroy_user_session_path, data: { turbo_method: :delete } %>
  </p>
<% else %>
  <p>
    <%= link_to "Sign Up", new_user_registration_path %> |
    <%= link_to "Log In", new_user_session_path %>
  </p>
<% end %>

<h2> NATHANS OLD VIEW </h2>
<% if current_user&.is_admin? %>
  <h1>Welcome Admin!</h1>
  <%= link_to "Admin competitions", admin_competitions_path %>
<% else %>
  <h1>Welcome to LeaguePal!</h1>
<% end %>

<%= link_to "All competitions", competitions_path %>
