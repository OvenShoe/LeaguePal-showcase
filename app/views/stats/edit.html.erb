<h1>Edit Stat</h1>

<%= simple_form_for [@game, @stat] do |f| %>
  <%= f.input :user_id, label: "Player", collection: @game.team_1.team_members.map(&:user) + @game.team_2.team_members.map(&:user) %>
  <%= f.input :label, label: "Stat label", as: :select, collection: ["goal", "assist", "save"].map { |l| [l.humanize, l] } %>
  <%= f.input :value, label: "Value" %>
  <%= f.button :submit, "Update stat", class: "btn btn-primary" %>
<% end %>