<div class="min-h-screen flex items-start justify-center pt-16 p-8 pb-32">
  <div class="w-full max-w-2xl">

    <h1 class="text-2xl font-bold text-gray-900 font-barlow text-center mb-6">Teams Centre</h1>

    <%# Captain teams %>
    <% if @captain_teams.present? %>
      <div class="bg-white rounded-2xl border border-gray-200 p-6 mb-6">
        <p class="text-xs text-gray-400 uppercase tracking-wider mb-4">Teams I captain</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <% @captain_teams.each do |team| %>
            <%= render partial: "shared/teamcard", locals: { team: team } %>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# Member teams %>
    <% if @user_teams.present? %>
      <div class="bg-white rounded-2xl border border-gray-200 p-6 mb-6">
        <p class="text-xs text-gray-400 uppercase tracking-wider mb-4">Teams I'm in</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <% @user_teams.each do |team| %>
            <%= render partial: "shared/teamcard", locals: { team: team } %>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# Empty state %>
    <% if @captain_teams.blank? && @user_teams.blank? %>
      <div class="bg-white rounded-2xl border border-gray-200 p-8 text-center">
        <p class="text-sm text-gray-400">You're not part of any teams yet.</p>
      </div>
    <% end %>

  </div>
</div>

<%# Fixed bottom nav bar %>
<div class="fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-gray-200 px-6 py-4">
  <div class="mx-auto max-w-2xl flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-center">
    <%= link_to competitions_path, class: "w-full sm:w-auto text-center rounded-xl px-4 py-2.5 text-sm font-medium bg-gray-100 text-gray-900 hover:bg-gray-200 transition-colors" do %>
      Back to competitions
    <% end %>
  </div>
</div>
