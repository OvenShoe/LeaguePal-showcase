<p>views/admin/competitions/show</p>
<h2><%= @competition.name %></h2>
<p>Sport: <%= @competition.sport %></p>
<p>Start Date: <%= @competition.start_date %></p>
<p>End Date: <%= @competition.end_date %></p>

<h2 class="mt-4">Teams</h2>
<ul>
  <% @competition.teams.each do |team| %>
    <li><%= team.name %></li>
  <% end %>
</ul>

<% if @teams.count > 1 %>
  <p>Number of teams: <%= @teams.count %></p>
<%end%>
<% if @competition.scaffold_generated? %>
  <p>League scaffold has been generated for this competition.</p>
<% else %>
  <%= link_to "Back to Competitions", admin_competitions_path %>
  <%# Submitted actions to Admin::CompetitionsController#send_invite %>
  <%= simple_form_for :team_invite, url: send_invite_admin_competition_path(@competition), local: true, method: :post do |f| %>
  <div class="form-inputs">
      <%= f.input :name, label: "Team Name" %>
      <%= f.input :invitee_email, label: "Email of invitee" %>
      <%= f.input :role, as: :radio_buttons, collection: [["Captain", "captain"], ["Player", "player"]], label: "Role", checked: "captain", required: true %>
  </div>
    <div class="form-actions">
      <%= f.button :submit, "Send Team Invite" %>
    </div>
  <% end %>

  <%= simple_form_for :team, url: create_team_admin_competition_path(@competition), local: true, method: :post do |f| %>
    <div class="form-inputs">
      <%= f.input :name, label: "Team Name" %>
      <%= f.input :captain_id,
        label: "Captain",
        collection: @available_captains.map { |user| [user.list_name, user.id] },
        prompt: "Select a captain" %>
    </div>
    <div class="form-actions">
      <%= f.button :submit, "Create Team" %>
    </div>
  <% end %>
<% end %>

<% if @teams.count >= 2 && !@competition.scaffold_generated? %>
  <%= simple_form_for @competition, url: generate_league_admin_competition_path(@competition), local: true, method: :post do |f| %>
    <div class="form-inputs">
      <%= label_tag :ties, "Times each team plays every other team" %>
      <%= number_field_tag :ties, 1, min: 1 %>
    </div>
    <div class="form-actions">
      <%= f.button :submit, "Generate league scaffold" %>
    </div>
  <% end %>
<% end %>



<% if @competition.scaffold_generated? %>
  <% round_count = 1 %>
  <%# Iterate over each round %>
  <% @competition.rounds.each do |round| %>
  <h2> Round: <%= round_count %></h2>
  <%# Iterate over every game %>
    <% round.games.each do |game| %>
      <p>Game Id: <%= game.id%> </p>
      <p>Team 1: <%= Team.find(game.team_1_id).name%></p>
      <p>Team 2: <%= Team.find(game.team_2_id).name%></p>
    <% end %>
  <% end %>
<% end %>
