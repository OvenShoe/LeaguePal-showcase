<%= simple_form_for [:admin, @competition], html: { novalidate: true } do |f| %>
  <%= f.error_notification class: "text-red-500 text-sm mb-4 text-center" %>

  <div class="space-y-6">

    <%= f.input :name,
        label: "Competition Name",
        label_html: { class: "block text-sm font-medium text-gray-900" },
        input_html: { class: "block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-600 sm:text-sm" },
        wrapper_html: { class: "space-y-1" } %>

    <%= f.input :sport,
        collection: Competition.sports.keys.map { |key| [key.titleize, key] },
        include_blank: "Select a sport",
        required: true,
        selected: (@competition.persisted? ? @competition.sport : nil),
        label: "Sport",
        label_html: { class: "block text-sm font-medium text-gray-900" },
        input_html: { class: "block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-600 sm:text-sm" },
        wrapper_html: { class: "space-y-1" } %>

    <%= f.input :start_date,
        as: :date,
        label_html: { class: "block text-sm font-medium text-gray-900" },
        input_html: { class: "block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-600 sm:text-sm" },
        wrapper_html: { class: "space-y-1" } %>

    <%= f.input :end_date,
        as: :date,
        label_html: { class: "block text-sm font-medium text-gray-900" },
        input_html: { class: "block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-600 sm:text-sm" },
        wrapper_html: { class: "space-y-1" } %>

    <div class="grid grid-cols-2 gap-8">
      <div>
        <p class="block text-sm font-medium text-gray-900 mb-2">Game days</p>
        <%= f.input :game_days,
            as: :check_boxes,
            collection: [
              ["Monday", 1],
              ["Tuesday", 2],
              ["Wednesday", 3],
              ["Thursday", 4],
              ["Friday", 5],
              ["Saturday", 6],
              ["Sunday", 0]
            ],
            include_hidden: false,
            label: false,
            item_wrapper_class: "flex items-center gap-2 py-1",
            item_label_class: "text-sm text-gray-700",
            input_html: { class: "rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" } %>
      </div>

      <div>
        <p class="block text-sm font-medium text-gray-900 mb-2">Game times</p>
        <%= f.input :start_times,
            as: :check_boxes,
            collection: [
              ["09:00", "09:00"],
              ["11:00", "11:00"],
              ["13:00", "13:00"],
              ["15:00", "15:00"],
              ["17:30", "17:30"],
              ["19:00", "19:00"]
            ],
            include_hidden: false,
            label: false,
            item_wrapper_class: "flex items-center gap-2 py-1",
            item_label_class: "text-sm text-gray-700",
            input_html: { class: "rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" } %>
      </div>
    </div>

    <%= f.button :submit, "Create Competition",
        class: "flex w-full justify-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-600 cursor-pointer" %>

  </div>
<% end %>
