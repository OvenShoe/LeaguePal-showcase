<div class="container">
    <h1>Edit Team</h1>

    <%= simple_form_for @team do |f| %>
        <%= f.error_notification %>

        <% if params[:token].present? %>
            <%= hidden_field_tag :token, params[:token] %>
        <% end %>

        <div class="form-inputs">
            <%= f.input :name %>
            <%= f.input :jersey, as: :file, label: "Jersey" %>
        </div>

        <div class="form-actions">
            <%= f.button :submit %>
        </div>
    <% end %>
</div>
