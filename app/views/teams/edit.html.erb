<div class="container">
    <h1>Edit Team</h1>

    <%= simple_form_for @team do |f| %>
        <%= f.error_notification %>

        <div class="form-inputs">
            <%= f.input :name %>
            <%= f.input :image, as: :file, label: "Jersey" %>
        </div>

        <div class="form-actions">
            <%= f.button :submit %>
        </div>
    <% end %>
</div>