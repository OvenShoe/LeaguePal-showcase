<div class="flex flex-col items-start justify-start font-barlow p-4 font-semibold">
  <h1 class="text-2xl mb-2">Welcome, <%= current_user.first_name %>!</h1>
  <%= link_to "View all competitions", competitions_path, class: "block hover:underline" %>
  <%= link_to "Create a new competition", competitions_path, class: "block hover:underline" %>

</div>

<div class="flex items-start justify-start font-barlow" >
</div>

<div class="flex items-start justify-start font-barlow" >
  <p class="hover:underline"><%= link_to "Create a new competition", new_admin_competition_path if current_user&.is_admin? %></p>
</div>

<div class="flex items-start justify-start p-4 font-barlow">

  <div class>
    <% if user_signed_in? %>
      <div>
        <p class="text-large">Signed in as <%= current_user.first_name%> email: <%= current_user.email%></p>
      </div>


      <div>
        <%= link_to "All competitions", competitions_path %>

        <%= link_to "Create New Competition", new_admin_competition_path if current_user&.is_admin? %>
        <p>
          <%= link_to "Edit Profile", edit_user_registration_path %> |
          <%= link_to "Log Out", destroy_user_session_path, data: { turbo_method: :delete } %>
        </p>
      </div>
    <% else %>
      <p>
        <%= link_to "Sign Up", new_user_registration_path %> |
        <%= link_to "Log In", new_user_session_path %>
      </p>
    <% end %>
  </div>
</div>

<% if user_signed_in? %>
  <p>Signed in as <%= current_user.email %></p>
  <p>
    <%= link_to "Edit Profile", edit_user_registration_path %> |
    <%= link_to "Log Out", destroy_user_session_path, data: { turbo_method: :delete } %>
  </p>
<% else %>
  <p>
    <%= link_to "Sign Up", new_user_registration_path %> |
    <%= link_to "Log In", new_user_session_path %>
  </p>
<% end %>

<h2> NATHANS OLD VIEW </h2>
<% if current_user&.is_admin? %>
  <h1>Welcome Admin!</h1>
  <%= link_to "Admin competitions", admin_competitions_path %>
<% else %>
  <h1>Welcome to LeaguePal!</h1>
<% end %>

<%= link_to "All competitions", competitions_path %>

<%= link_to "Create New Competition", new_admin_competition_path if current_user&.is_admin? %>

<% if user_signed_in? && current_user.has_games? %>
  <div>
    <%= link_to "View Game", game_path(current_user.next_game.id) %>
    <%= render "shared/matchcard", game: current_user.next_game %>
  </div>
<% end %>
