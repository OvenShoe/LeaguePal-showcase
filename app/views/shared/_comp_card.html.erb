<% competitions.each do |comp| %>
  <% path = current_user.admin? ? admin_competition_path(comp) : competition_path(comp) %>
  <% team = current_user.teams.find_by(competition_id: comp.id) %>

  <%= link_to path, class: "block mb-3" do %>
    <div class="bg-white rounded-2xl border border-gray-200 p-6 hover:border-emerald-300 hover:shadow-sm transition-all duration-150 cursor-pointer">

      <%# Competition name %>
      <h2 class="text-base font-semibold text-gray-900 mb-1">
        <%= comp.name.present? ? comp.name : "Unnamed competition" %>
      </h2>

      <%# Sport + date meta %>
      <div class="flex items-center gap-3 text-xs text-gray-400 mb-4">
        <span><%= comp.sport.present? ? comp.sport : "No sport listed" %></span>
        <span>·</span>
        <span><%= comp.start_date.present? ? comp.start_date.strftime('%B %d, %Y') : "No start date" %></span>
      </div>

      <div class="border-t border-gray-100 pt-4">
        <% if current_user && team %>
          <%# Team joined %>
          <div class="flex items-center gap-3">
            <% if team.logo.present? %>
              <%= image_tag team.logo, class: "w-9 h-9 rounded-lg object-cover border border-gray-200" %>
            <% else %>
              <div class="w-9 h-9 rounded-lg bg-emerald-50 flex items-center justify-center text-xs font-semibold text-emerald-700">
                <%= team.name[0].upcase %>
              </div>
            <% end %>
            <div>
              <p class="text-xs text-gray-400">Your team</p>
              <p class="text-sm font-medium text-gray-900"><%= team.name %></p>
            </div>
          </div>
        <% else %>
          <%# No team %>
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-lg bg-gray-100 flex items-center justify-center">
              <span class="w-4 h-4 rounded-full bg-gray-300 block"></span>
            </div>
            <p class="text-sm text-gray-400">No team joined</p>
          </div>
        <% end %>
      </div>

    </div>
  <% end %>
<% end %>
