<div class="min-h-screen flex items-start justify-center p-8">
  <div class="w-full max-w-md">

    <% if user_signed_in? %>

      <h1 class="text-2xl font-bold text-gray-900 mb-1 text-center font-barlow">
        Welcome, <%= current_user.first_name %>!
      </h1>
      <p class="text-sm text-gray-400 text-center mb-6">What would you like to do today?</p>

      <div class="bg-white rounded-2xl border border-gray-200 w-full p-8 space-y-2">

        <%# Admin section - only for admins %>
        <% if current_user&.admin? %>
          <p class="text-xs text-gray-400 uppercase tracking-wider mb-2">Admin</p>
          <%= link_to admin_competitions_path, class: "flex items-start pt-4 justify-between w-full text-sm font-medium text-gray-900 hover:text-emerald-700 py-3 transition-colors" do %>
            Admin competitions
            <span class="text-gray-300">›</span>
          <% end %>
          <%= link_to new_admin_competition_path, class: "flex items-center justify-between w-full text-sm font-medium text-gray-900 hover:text-emerald-700 py-3 transition-colors" do %>
            Create new competition
            <span class="text-gray-300">›</span>
          <% end %>
          <div class="border-t border-gray-100 my-4"></div>
        <% end %>

        <%# General section %>
        <p class="text-xs text-gray-400 uppercase tracking-wider mb-2">General</p>
        <%= link_to competitions_path, class: "flex items-center justify-between w-full text-sm font-medium text-gray-900 hover:text-emerald-700 py-3 transition-colors" do %>
          All competitions
          <span class="text-gray-300">›</span>
        <% end %>
        <%= link_to teams_path, class: "flex items-center justify-between w-full text-sm font-medium text-gray-900 hover:text-emerald-700 py-3 transition-colors" do %>
          My teams
          <span class="text-gray-300">›</span>
        <% end %>
        <%= link_to competitions_path, class: "flex items-center justify-between w-full text-sm font-medium text-gray-900 hover:text-emerald-700 py-3 transition-colors" do %>
          My competitions
          <span class="text-gray-300">›</span>
        <% end %>

        <div class="border-t border-gray-100 my-4"></div>

        <%# Account section %>
        <p class="text-xs text-gray-400 uppercase tracking-wider mb-2">Account</p>
        <%= link_to edit_user_registration_path, class: "flex items-center justify-between w-full text-sm font-medium text-gray-900 hover:text-emerald-700 py-3 transition-colors" do %>
          Edit profile
          <span class="text-gray-300">›</span>
        <% end %>
        <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "flex items-center justify-between w-full text-sm font-medium text-red-500 hover:text-red-700 py-3 transition-colors" do %>
          Log out
          <span class="text-red-300">›</span>
        <% end %>

      </div>

    <% else %>

      <div class="bg-white rounded-2xl border border-gray-200 w-full p-8 text-center">
        <p class="text-sm font-medium text-gray-900 mb-4">Welcome to League Pal</p>
        <div class="flex items-center justify-center gap-3 text-xs text-gray-400">
          <%= link_to "Sign up", new_user_registration_path, class: "hover:text-gray-700 transition-colors" %>
          <span>·</span>
          <%= link_to "Log in", new_user_session_path, class: "hover:text-gray-700 transition-colors" %>
        </div>
      </div>

    <% end %>

  </div>
</div>
