<h2><%= @team.name %></h2>
<p>
  <div class="w-20 h-20 object-cover" >
    <%= image_tag @team.jersey if @team.jersey.attached? %>
  </div>
</p>
<h3>Team Members:</h3>
<ul>
  <% @team_members.each do |member| %>
    <li><%= member.user.first_name %> <%= member.user.last_name %> - <%= member.role.capitalize %></li>
  <% end %>
</ul>
<% if current_user&.is_captain_of?(@team) %>
  <%= link_to "Edit", edit_team_path(@team) %>
  <%= link_to "Back", teams_path %>

  <h3 class="mt-6">Add Existing User</h3>
  <%= simple_form_for @team_member, url: add_member_team_path(@team), method: :post do |f| %>
    <% if @users.any? %>
      <%= f.association :user, collection: @users, label_method: :list_name, prompt: "Select a user" %>
    <% else %>
      <p>No users available to invite.</p>
    <% end %>
      <%= f.button :submit, "Add to team", data: { confirm: "Are you sure you want to add this user to the team?" } %>
  <% end %>

  <h3 class="mt-6">Invite New User by Email</h3>
  <%= simple_form_for :team_invitation, url: send_invite_team_path(@team), method: :post do |f| %>
    <%= f.input :invitee_email, label: "Email", required: true, input_html: { type: 'email' } %>
    <%= f.button :submit, "Send Invitation" %>
  <% end %>
<% end %>

<%# Player avatar %>
<% if user_signed_in? %>
  <% current_member = @team.team_members.find_by(user: current_user) %>
    <% if current_member %>

      <h3>Your Avatar for <%= @team.name %></h3>

      <div style="display:flex; gap:15px; flex-wrap:wrap; margin-bottom:20px;">
        <% TeamAvatar.where(user: current_user, team: @team).order(created_at: :desc).limit(8).each do |ta| %>
          <% selected = current_user.avatar.attached? && current_user.avatar.blob_id == ta.blob_id%>

          <div style="text-align:center">
            <%= button_to set_avatar_path(ta.blob_id), method: :post, style: "border:none; background:none; padding:0;" do %>
              <%= image_tag rails_blob_path(ta.blob, disposition: "inline"), width: 120, height: 120, style: "border-radius:50%; object-fit:cover; cursor:pointer; border:5px solid #{selected ? '#4CAF50' : '#ddd'};" %>
            <% end %>

            <small><%= selected ? "Current Avatar" : "Click to use" %></small>

            <%= button_to delete_ai_avatar_path(ta.blob_id), method: :delete,
                data: { turbo_confirm: "Delete this avatar?" },
                style: "display:block; margin-top:4px; background:#e53e3e; color:white; border:none; border-radius:4px; padding:3px 10px; cursor:pointer; font-size:12px;" do  %>
              🗑 Delete
            <% end %>
          </div>
        <% end %>
      </div>

    <% if !current_user.avatar.attached? %>
      <p>
        <small style="color:#999"> Upload a profile photo in <%= link_to "account settings", edit_user_registration_path %> to generate an avatar. </small>
      </p>
    <% elsif !@team.jersey.attached? %>
      <p>
        <small style="color:#999"> Waiting for the captain to upload a team jersey.</small>
      </p>
    <% else %>
      <%= button_to "Generate My #{@team.name} Avatar",
          generate_ai_avatar_users_path,
          method: :post,
          params: { team_id: @team.id },
          data: { turbo_submits_with: "Generating your #{@team.name} Avatar, please wait... this takes ~20 seconds" } %>
    <% end %>

    <hr>

    <%# Logo and Jersey display %>
    <% if @team.logo.attached? || @team.jersey.attached? %>
      <h3><%= @team.name %> Kit </h3>
      <div style="display:flex; gap:20px; flex-wrap:wrap;">
        <% if @team.logo.attached? %>
          <div style="text-align:center">
            <%= image_tag @team.logo, width: 120, style: "border-radius:8px;" %>
            <p><small>Team logo</small></p>
          </div>
        <% end %>
        <% if @team.jersey.attached? %>
          <div style="text-align:center">
            <%= image_tag @team.jersey, width: 120, style: "border-radius:8px;" %>
            <p><small>Team jersey</small></p>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# Captain-only edit %>

    <% if current_user&.is_captain_of?(@team) %>
      <%= link_to "Manage Team Logo and Jersey ->", edit_team_path(@team) %>
    <% end %>
  <% end %>
<% end %>

<% if @invitation_token.present? && @invitation.present? %>
  <div data-controller="team-popup"
       data-team-popup-token-value="<%= @invitation_token %>"
       data-team-popup-accept-url-value="<%= team_invitation_accept_path(@invitation) %>"
       data-team-popup-reject-url-value="<%= team_invitation_reject_path(@invitation) %>"
       data-team-popup-team-name-value="<%= @team.name %>"
       style="position: fixed; inset: 0; background-color: rgba(0, 0, 0, 0.5); display: flex; align-items: center; justify-content: center; z-index: 9999;">
    <div style="background-color: white; border-radius: 0.5rem; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1); padding: 1.5rem; max-width: 28rem; margin: 1rem;">
      <h2 style="font-size: 1.25rem; font-weight: bold; margin-bottom: 1rem;">Accept invitation?</h2>
      <p style="color: #374151; margin-bottom: 1.5rem;">You've been invited to join <strong><%= @team.name %></strong></p>
      <div style="display: flex; gap: 1rem;">
        <button data-action="click->team-popup#acceptInvitation" style="flex: 1; background-color: #22c55e; color: white; font-weight: bold; padding: 0.5rem 1rem; border-radius: 0.25rem; border: none; cursor: pointer;">
          Accept
        </button>
        <button data-action="click->team-popup#rejectInvitation" style="flex: 1; background-color: #ef4444; color: white; font-weight: bold; padding: 0.5rem 1rem; border-radius: 0.25rem; border: none; cursor: pointer;">
          Decline
        </button>
      </div>
    </div>
  </div>
<% end %>
