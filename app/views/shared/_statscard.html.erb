<div class="rounded-md border border-neutral-200 p-3 bg-white">
  <% if local_assigns[:title] %>
    <h2 class="font-bold text-xl mb-2"><%= title %></h2>
  <% end %>
  <table class="w-full text-left">
    <thead>
      <tr>
        <% if local_assigns[:show_user] %>
          <th class="py-1 px-2"></th> <!-- Avatar column header (empty) -->
          <th class="py-1 px-2">Stat</th>
          <th class="py-1 px-2">Player</th>
          <th class="py-1 px-2">Value</th>
        <% else %>
          <th class="py-1 px-2">Team</th> <!-- Team logo/name column, no header -->
          <th class="py-1 px-2">Stat</th>
          <th class="py-1 px-2">Value</th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% if local_assigns[:show_user] %>
        <% (local_assigns[:all_labels] || top_stats.keys).each do |label| %>
          <% stat = Array(top_stats[label]).compact.first %>
          <%= render "shared/stat_row", label: label, stat: stat, show_user: local_assigns[:show_user] %>
        <% end %>
      <% else %>
        <% top_stats.each do |label, data| %>
          <% team = data[:team] if data.is_a?(Hash) %>
          <tr>
            <td class="py-1 px-2">
              <% if team&.logo&.attached? %>
                <%= image_tag team.logo, width: 60, style: "border-radius:8px;" %>
              <% else %>
                <span class="inline-block w-8 h-8 rounded-full bg-gray-300 mr-2 align-middle"></span>
              <% end %>
              <%= link_to team&.name, team_path(team) || 'Unknown Team' %>
            </td>
            <td class="py-1 px-2"><%= label.to_s.titleize %></td>
            <td class="py-1 px-2">
              <% if data.is_a?(Hash) && data[:value] %>
                <%= data[:value] %>
              <% elsif defined?(stat_totals) && stat_totals[label] %>
                <%= stat_totals[label] %>
              <% else %>
                <!-- Value not available -->
              <% end %>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>
