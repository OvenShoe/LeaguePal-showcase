<div class="container mx-auto px-4 py-8">

  <div class="container mx-auto px-4 py-4">

  <h2 class="font-bold text-2xl">Next Game</h1>
  <h2 class="font-bold text-2xl mb-6">Next Game</h1>
  <%= render "/shared/matchcard" %>
  <h2 class="font-bold text-2xl mt-6">Competition Standings</h1>
  <%= render "/shared/standingstable" %>
    <%= link_to "Create New Competition", new_admin_competition_path if current_user&.is_admin? %>
  <h2 class="font-bold text-2xl mb-2">Competition Statistics</h1>
    <ul class="grid grid-cols-6 text-left w-full mb-4">
      <li class="hover:font-bold">Attack</li>
      <li class="hover:font-bold">Defence</li>
    </ul>

  <%= render "/shared/statscard" %>

</div>


  <h1 class="font-bold text-4xl mb-4"><%= @competition.name %></h1>
  <%= render "shared/nav" %>
  <div class="mb-6">
    <h2 class="text-2xl mb-4">Next Match</h2>
    <%= render "shared/matchcard" %>
    <h2 class="text-2xl mt-4">Competition Standings</h2>
    <%= render "shared/standingstable" %>
    <h2 class="text-2xl mt-4">Competition Statistics</h2>
    <%= render "shared/statscard" %>


  <% if current_user&.is_admin? %>
    <div class="mb-8">
      <h2 class="text-2xl font-semibold mb-4">Admin Actions</h2>
      <%= link_to "Manage Competition Invites", admin_competition_path(@competition), class: "text-blue-600 hover:underline" %>
    </div>
  <% end %>
  <div class="">
  <%= link_to "Back to Competitions", competitions_path, class: 'mt-10 bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 border border-blue-700 rounded' %>
  </div>
</div>
