<div class="container mx-auto px-4 py-8">
  <nav class="font-barlowlight my-4 p-2">
  <ul class="grid grid-cols-3 text-center w-full">
    <li class="font-bold underline"><%= link_to "My competitions", competitions_path %></li>
    <li class="font-bold underline"><%= link_to "Competition Games", games_path %></li>
   <% if @user_teams.present? %>
      <% @user_teams.each do |team| %>
        <li class="font-bold underline"><%= link_to "My team", team_path(team) %></li>
      <% end %>
    <% end %>
  </ul>
</nav>

  <div class="container mx-auto px-4 py-4">

  <h1 class="font-bold text-4xl mb-4"><%= @competition.name %></h1>

  <div class="mb-6">
    <% if @competition.scaffold_generated? %>
      <div>
          <div class="flex justify-center">
            <p class="text-lg font-bold">Next Match</p>
          </div>
          <div class="flex justify-center">
            <%= link_to "View Game", game_path(@next_game) %>
          </div>
          <div>
            <%= render "shared/matchcard", game: @next_game %>
          </div>
          <div>
            <%= render "shared/statscard", top_stats: @competition.top_team_per_stat, title: "Top Team Stats", show_user: false %>
          </div>
        <div>
    <% end %>
    
    </div>
    <h2 class="text-2xl mt-4">Competition Standings</h2>
    <%= render "shared/standingstable", competition: @competition %>

  <%# stats card %>
  <%= render "shared/statscard", top_stats: @top_stats, title: "Top Player Stats", show_user: true %>
</div>




  <% if current_user&.is_admin? %>
    <div class="mb-8">
      <h2 class="text-2xl font-semibold mb-4">Admin Actions</h2>
      <%= link_to "Manage Competition Invites", admin_competition_path(@competition), class: "text-blue-600 hover:underline" %>
    </div>
  <% end %>
  <div class="">
  <%= link_to "Back to Competitions", competitions_path, class: 'mt-10 bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 border border-blue-700 rounded' %>
  </div>
</div>
