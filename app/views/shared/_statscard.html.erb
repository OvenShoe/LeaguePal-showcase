<div class="rounded-md border border-neutral-200 dark:border-neutral-700 p-3 bg-white dark:bg-neutral-900">
  <% if local_assigns[:title] %>
    <h2 class="font-bold text-xl mb-2"><%= title %></h2>
  <% end %>
  <table class="w-full text-left">
    <thead>
      <tr>
        <% if local_assigns[:show_user] %>
          <th class="py-1 px-2"></th> <!-- Avatar column header (empty) -->
        <% end %>
        <th class="py-1 px-2">Stat</th>
        <% if local_assigns[:show_user] %>
          <th class="py-1 px-2">Player</th>
        <% end %>
        <th class="py-1 px-2">Value</th>
      </tr>
    </thead>
    <tbody>
      <% (local_assigns[:all_labels] || top_stats.keys).each do |label| %>
        <% stat = Array(top_stats[label]).compact.first %>
        <%= render "shared/stat_row", label: label, stat: stat, show_user: local_assigns[:show_user] %>
      <% end %>
    </tbody>
  </table>
</div>
