<!DOCTYPE html>
<html>
  <head>
  <title><%= content_for(:title) || "League Pal" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="application-name" content="League Pal">
  <meta name="mobile-web-app-capable" content="yes">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= yield :head %>

  <link rel="icon" href="<%= asset_path('logo.png') %>" type="image/png">
  <link rel="apple-touch-icon" href="<%= asset_path('logo.png') %>">

  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>

  <body class="flex flex-col min-h-screen">
    <% if flash[:notice] %>
      <div class="mb-4 rounded bg-green-100 border border-green-400 text-green-700 px-4 py-3 text-center">
        <%= flash[:notice] %>
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div class="mb-4 rounded bg-red-100 border border-red-400 text-red-700 px-4 py-3 text-center">
        <%= flash[:alert] %>
      </div>
    <% end %>
  <%= render "/shared/header" %>
  <main class="flex justify-center flex-1">
    <%= yield %>
  </main>
</body>
</html>
