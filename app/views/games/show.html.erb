<% content_for :title, "Showing game" %>

<div class="min-h-screen flex items-start justify-center pt-16 p-8 pb-32">
  <div class="w-full max-w-2xl">

    <% if notice.present? %>
      <div class="rounded-2xl bg-emerald-50 border border-emerald-200 px-5 py-4 text-sm text-emerald-700 mb-6">
        <%= notice %>
      </div>
    <% end %>

    <h1 class="text-2xl font-bold text-gray-900 font-barlow text-center mb-6">Game Center</h1>

    <%# Match card — no wrapper, renders its own card %>
    <%= render "/shared/matchcard", game: @game %>
    <br>

    <%# Add stat — admin only %>
    <% if current_user.admin? %>
      <div class="bg-white rounded-2xl border border-gray-200 p-6 mb-6">
        <h2 class="text-sm font-semibold text-gray-900 font-barlow mb-4">Add a stat</h2>
        <%= simple_form_for [@game, Stat.new] do |f| %>
          <div class="space-y-4">
            <%= f.input :user_id,
                label: "Player",
                collection: @players,
                prompt: "Select a player",
                label_html: { class: "block text-sm font-medium text-gray-900" },
                input_html: { class: "block w-full rounded-xl border border-gray-200 bg-white px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 sm:text-sm" },
                wrapper_html: { class: "space-y-1" } %>
            <%= f.input :label,
                label: "Stat label",
                as: :select,
                collection: @all_labels.map { |l| [l.to_s.humanize, l] },
                prompt: "Select a stat",
                label_html: { class: "block text-sm font-medium text-gray-900" },
                input_html: { class: "block w-full rounded-xl border border-gray-200 bg-white px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 sm:text-sm" },
                wrapper_html: { class: "space-y-1" } %>
            <%= f.input :value,
                label: "Value",
                label_html: { class: "block text-sm font-medium text-gray-900" },
                input_html: { class: "block w-full rounded-xl border border-gray-200 bg-white px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 sm:text-sm" },
                wrapper_html: { class: "space-y-1" } %>
            <%= f.button :submit, "Add stat",
                class: "flex w-full justify-center rounded-xl bg-emerald-600 px-3 py-2 text-sm font-semibold text-white hover:bg-emerald-500 cursor-pointer transition-colors" %>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# Top stats — turbo frame %>
    <div class="bg-white rounded-2xl border border-gray-200 p-6 mb-6">
      <turbo-frame id="statscard">
        <%= render "shared/statscard", top_stats: @top_stats, all_labels: @all_labels, title: "Top Stats This Game", show_user: true %>
      </turbo-frame>
      <%= turbo_stream_from @game %>
    </div>

    <%# Live stats %>
    <div class="bg-white rounded-2xl border border-gray-200 p-6 mb-6">
      <h2 class="text-sm font-semibold text-gray-900 font-barlow mb-4">Live stats</h2>
      <div class="max-h-96 overflow-y-auto">
        <% if current_user.admin? %>
          <%= render "stats/admin_list", game: @game, stats: @game.stats.includes(:user).order(created_at: :desc), can_edit: current_user.admin? %>
        <% else %>
          <%= render "stats/list", stats: @game.stats.includes(:user).order(created_at: :desc), game: @game %>
        <% end %>
      </div>
    </div>

  </div>
</div>

<%# Fixed bottom nav bar %>
<div class="fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-gray-200 px-6 py-4">
  <div class="mx-auto max-w-2xl">
    <% if current_user.admin? %>
      <div class="flex flex-col gap-2 sm:flex-row sm:items- justify-center">
        <% unless @game.complete? %>
          <%= button_to "End game", complete_game_game_path(@game),
              method: :patch,
              form_class: "sm:inline-block w-full sm:w-auto",
              class: "w-full sm:w-auto text-center rounded-xl px-4 py-2.5 text-sm font-semibold bg-emerald-600 text-white hover:bg-emerald-500 cursor-pointer transition-colors",
              data: { turbo_confirm: "Mark this game as complete?" } %>
        <% end %>
        <%= link_to "Edit game", edit_admin_round_path(@game),
            class: "w-full sm:w-auto text-center rounded-xl px-4 py-2.5 text-sm font-medium bg-gray-100 text-gray-900 hover:bg-gray-200 transition-colors" %>
        <%= link_to "Back to round", admin_round_path(@game.round),
            class: "w-full sm:w-auto text-center rounded-xl px-4 py-2.5 text-sm font-medium bg-gray-100 text-gray-900 hover:bg-gray-200 transition-colors" %>
        <%= button_to "Delete game", @game,
            method: :delete,
            form_class: "sm:inline-block w-full sm:w-auto",
            class: "w-full sm:w-auto text-center rounded-xl px-4 py-2.5 text-sm font-semibold text-white bg-red-500 hover:bg-red-600 cursor-pointer transition-colors",
            data: { turbo_confirm: "Are you sure?" } %>
      </div>
    <% else %>
      <%= link_to "Back to games", competition_games_path(@game.competition),
          class: "w-full sm:w-auto text-center rounded-xl px-4 py-2.5 text-sm font-medium bg-gray-100 text-gray-900 hover:bg-gray-200 transition-colors inline-block" %>
    <% end %>
  </div>
</div>
