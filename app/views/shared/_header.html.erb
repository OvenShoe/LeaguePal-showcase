<header class="bg-white border-b border-gray-200 px-4 py-3">
  <div class="flex items-center justify-between max-w-2xl mx-auto w-full">

    <%# Logo + Title — centred as a group %>
    <div class="flex-1 flex justify-center">
      <%= link_to root_path, class: "flex items-center gap-2 font-barlow text-xl font-medium text-gray-900" do %>
        <%= image_tag "logo.png", class: "w-8 h-8 object-contain" %>
        League Pal
      <% end %>
    </div>

    <%# Avatar — fixed width right %>
    <div class="w-10 flex-shrink-0 flex justify-end relative" data-controller="dropdown">
      <% if user_signed_in? %>
        <button type="button" data-action="click->dropdown#toggle click@window->dropdown#hide" class="focus:outline-none">
          <% if current_user.ai_avatars.attached? %>
            <%= image_tag current_user.ai_avatars.last, class: "w-9 h-9 rounded-full object-cover cursor-pointer ring-2 ring-gray-200" %>
          <% elsif current_user.avatar.attached? %>
            <%= image_tag current_user.avatar, class: "w-9 h-9 rounded-full object-cover cursor-pointer ring-2 ring-gray-200" %>
          <% else %>
            <span class="w-9 h-9 rounded-full bg-emerald-600 text-white text-sm font-semibold flex items-center justify-center cursor-pointer">
              <%= current_user.first_name&.first&.upcase %>
            </span>
          <% end %>
        </button>

        <div data-dropdown-target="menu" class="hidden absolute right-0 mt-10 w-44 bg-white rounded-xl shadow-lg border border-gray-100 py-1 z-50 text-sm text-left">
          <%= link_to "Edit profile", edit_user_registration_path, class: "block px-4 py-2 text-gray-700 hover:bg-gray-50 transition-colors" %>
          <%= button_to "Log out", destroy_user_session_path, method: :delete, class: "w-full text-left px-4 py-2 text-gray-700 hover:bg-gray-50 transition-colors bg-transparent border-0 cursor-pointer" %>
        </div>
      <% else %>
        <div class="w-9"></div>
      <% end %>
    </div>

  </div>
</header>
