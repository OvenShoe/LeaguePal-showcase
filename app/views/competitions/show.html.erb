<div class="container mx-auto px-4 py-8">
  <nav class="font-barlowlight my-4 p-2">
    <div class="w-full flex justify-between">
      <ul class="flex justify-between w-full">
        <li class="font-bold underline"><%= link_to "My competitions", competitions_path, class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium m-4" %></li>
        <li class="font-bold underline"><%= link_to "Competition Games", competition_games_path(@competition), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium m-4" %></li>
        <% if @user_teams.present? %>
          <% @user_teams.each do |team| %>
            <li class="font-bold underline"><%= link_to "My team", team_path(team) %></li>
          <% end %>
        <% end %>
      </ul>
    </div>
  </nav>

  <div class="container mx-auto px-4 py-4">

  <h1 class="font-bold text-4xl mb-4 text-center"><%= @competition.name %></h1>

  <div class="mb-6">
    <% if @competition.scaffold_generated? && @next_game.present? %>
      <div>
          <div class="flex justify-center">
            <p class="text-lg font-bold">Next Match</p>
          </div>
          <div class="flex justify-center">
            <%= link_to "View Game", game_path(@next_game) %>
          </div>
          <div>
            <%= render "shared/matchcard", game: @next_game %>
          </div>
          <div>
            <%= render "shared/statscard", top_stats: @competition.top_team_per_stat, title: "Top Team Stats", show_user: false %>
          </div>
        <div>
    <% else %>
        <div>
          <div class="flex justify-center">
            <p class="text-lg font-bold">Next Match</p>
          </div>
          <div class="flex justify-center">
            <p class="text-gray-500">No upcoming matches available.</p>
          </div>
          <div>
        </div>
    <% end %>
    
    </div>
    <h2 class="text-2xl mt-4 text-center">Competition Standings</h2>
    <%= render "shared/standingstable", competition: @competition %>

  <%# stats card %>
  <%= render "shared/statscard", top_stats: @top_stats, title: "Top Player Stats", show_user: true %>
</div>



  <div class="flex flex-col items-center text-center w-full">
    <% if current_user&.is_admin? %>
      <div class="mb-8 flex flex-col items-center text-center w-full">
        <h2 class="text-2xl font-semibold mb-4">Admin Actions</h2>
        <%= link_to "Edit Competition", edit_admin_competition_path(@competition), class: "mb-2" %>
        <%= link_to "Manage Competition Invites", admin_competition_path(@competition), class: "text-blue-600 hover:underline mb-2" %>
      </div>
    <% end %>
    <div class="flex flex-col items-center text-center w-full">
      <%= link_to "To Admin Competitions", admin_competitions_path, class: 'mt-10 mb-2 bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 border border-blue-700 rounded' if current_user.is_admin? %>
      <%= link_to "Back to Competitions", competitions_path, class: 'mt-2 bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 border border-blue-700 rounded' %>
    </div>
  </div>
</div>
