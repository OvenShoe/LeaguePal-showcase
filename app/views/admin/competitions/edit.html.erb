<div class="min-h-screen flex items-start justify-center pt-16 p-8 pb-32">
  <div class="w-full max-w-2xl">

    <h1 class="text-2xl font-bold text-gray-900 font-barlow text-center mb-6">
      Edit competition
    </h1>

    <%= simple_form_for([:admin, @competition], local: true) do |f| %>

      <%= f.error_notification wrapper_html: { class: "rounded-2xl bg-red-50 border border-red-200 px-5 py-4 text-sm text-red-700 mb-6" } %>
      <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

      <%# Competition details %>
      <div class="bg-white rounded-2xl border border-gray-200 p-6 mb-6">
        <p class="text-xs text-gray-400 uppercase tracking-wider mb-4">Competition details</p>
        <div class="space-y-4">
          <%= f.input :name,
              label: "Competition name",
              label_html: { class: "block text-sm font-medium text-gray-900" },
              input_html: { class: "block w-full rounded-xl border border-gray-200 bg-white px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 sm:text-sm" },
              wrapper_html: { class: "space-y-1" } %>
          <%= f.input :sport,
              collection: Competition.sports.keys.map { |key| [key, key] },
              include_blank: false,
              label: "Sport",
              label_html: { class: "block text-sm font-medium text-gray-900" },
              input_html: { class: "block w-full rounded-xl border border-gray-200 bg-white px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 sm:text-sm" },
              wrapper_html: { class: "space-y-1" } %>
          <%= f.input :start_date,
              as: :datetime,
              order: [:day, :month, :year],
              label_html: { class: "block text-sm font-medium text-gray-900" },
              input_html: { class: "rounded-xl border border-gray-200 bg-white px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 sm:text-sm" },
              wrapper_html: { class: "space-y-1" } %>
          <%= f.input :end_date,
              as: :datetime,
              order: [:day, :month, :year],
              label_html: { class: "block text-sm font-medium text-gray-900" },
              input_html: { class: "rounded-xl border border-gray-200 bg-white px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 sm:text-sm" },
              wrapper_html: { class: "space-y-1" } %>
        </div>
      </div>

      <%# Game days and times — only if scaffold not yet generated %>
      <% if !@competition.scaffold_generated? %>
        <div class="grid grid-cols-2 gap-4 mb-6">

          <div class="bg-white rounded-2xl border border-gray-200 p-6">
            <p class="text-xs text-gray-400 uppercase tracking-wider mb-4">Game days</p>
            <%= f.input :game_days,
                as: :check_boxes,
                collection: [
                  ["Monday", 1],
                  ["Tuesday", 2],
                  ["Wednesday", 3],
                  ["Thursday", 4],
                  ["Friday", 5],
                  ["Saturday", 6],
                  ["Sunday", 0]
                ],
                include_hidden: false,
                label: false,
                item_wrapper_class: "flex items-center gap-2 py-1",
                item_label_class: "text-sm text-gray-700",
                input_html: { class: "rounded border-gray-300 text-emerald-600 focus:ring-emerald-500" } %>
          </div>

          <div class="bg-white rounded-2xl border border-gray-200 p-6">
            <p class="text-xs text-gray-400 uppercase tracking-wider mb-4">Game times</p>
            <%= f.input :start_times,
                as: :check_boxes,
                collection: [
                  ["09:00", "09:00"],
                  ["11:00", "11:00"],
                  ["13:00", "13:00"],
                  ["15:00", "15:00"],
                  ["17:30", "17:30"],
                  ["19:00", "19:00"]
                ],
                include_hidden: false,
                label: false,
                item_wrapper_class: "flex items-center gap-2 py-1",
                item_label_class: "text-sm text-gray-700",
                input_html: { class: "rounded border-gray-300 text-emerald-600 focus:ring-emerald-500" } %>
          </div>

        </div>
      <% end %>

      <%= f.button :submit, "Save competition",
          class: "flex w-full justify-center rounded-xl bg-emerald-600 px-3 py-2 text-sm font-semibold text-white hover:bg-emerald-500 cursor-pointer transition-colors mb-6" %>

    <% end %>

  </div>
</div>

<%# Fixed bottom nav bar %>
<div class="fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-gray-200 px-6 py-4">
  <div class="mx-auto max-w-2xl flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-center">
    <%= link_to admin_competition_path(@competition), class: "w-full sm:w-auto text-center rounded-xl px-4 py-2.5 text-sm font-medium bg-gray-100 text-gray-900 hover:bg-gray-200 transition-colors" do %>
      Show competition
    <% end %>
    <%= link_to admin_competitions_path, class: "w-full sm:w-auto text-center rounded-xl px-4 py-2.5 text-sm font-medium bg-gray-100 text-gray-900 hover:bg-gray-200 transition-colors" do %>
      All competitions
    <% end %>
  </div>
</div>
