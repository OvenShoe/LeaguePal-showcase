<div class="min-h-screen flex items-start justify-center pt-16 p-8 pb-32">
  <div class="w-full max-w-2xl">

    <% current_team_member = @team.team_members.find_by(user: current_user) %>

    <% if current_team_member&.captain? %>

      <h1 class="text-2xl font-bold text-gray-900 font-barlow text-center mb-6">
        Edit <%= @team.name %>
      </h1>

      <%# Team name %>
      <div class="bg-white rounded-2xl border border-gray-200 p-6 mb-6">
        <p class="text-xs text-gray-400 uppercase tracking-wider mb-4">Team details</p>
        <%= simple_form_for @team, html: { multipart: true, data: { turbo: false } } do |f| %>
          <%= f.error_notification wrapper_html: { class: "rounded-2xl bg-red-50 border border-red-200 px-5 py-4 text-sm text-red-700 mb-4" } %>
          <% if params[:token].present? %>
            <%= hidden_field_tag :token, params[:token] %>
          <% end %>
          <div class="space-y-4">
            <%= f.input :name,
                label_html: { class: "block text-sm font-medium text-gray-900" },
                input_html: { class: "block w-full rounded-xl border border-gray-200 bg-white px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 sm:text-sm" },
                wrapper_html: { class: "space-y-1" } %>
            <%= f.button :submit, "Save team",
                class: "flex w-full justify-center rounded-xl bg-emerald-600 px-3 py-2 text-sm font-semibold text-white hover:bg-emerald-500 cursor-pointer transition-colors" %>
          </div>
        <% end %>
      </div>

      <%# Team logo %>
      <div class="bg-white rounded-2xl border border-gray-200 p-6 mb-6">
        <p class="text-xs text-gray-400 uppercase tracking-wider mb-4">Team logo</p>

        <% if @team.logo.attached? %>
          <div class="flex flex-col items-center mb-4">
            <%= image_tag @team.logo, class: "w-24 h-24 rounded-xl object-cover border border-gray-200" %>
            <p class="text-xs text-gray-400 mt-2">Current logo</p>
          </div>
        <% else %>
          <p class="text-sm text-gray-400 mb-4">No <%= @team.name %> logo present.</p>
        <% end %>

        <div class="space-y-4">
          <div>
            <p class="text-sm font-medium text-gray-900 mb-2">Upload a logo</p>
            <%= form_with url: upload_logo_team_path(@team), method: :patch, multipart: true, data: { turbo: false } do |f| %>
              <div class="space-y-3">
                <%= f.file_field :logo, accept: "image/*",
                    class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-medium file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100 cursor-pointer" %>
                <%= f.submit "Upload logo",
                    class: "flex w-full justify-center rounded-xl bg-emerald-600 px-3 py-2 text-sm font-semibold text-white hover:bg-emerald-500 cursor-pointer transition-colors" %>
              </div>
            <% end %>
          </div>

          <div class="border-t border-gray-100 pt-4">
            <p class="text-sm font-medium text-gray-900 mb-2">Generate a logo with AI</p>
            <%= form_with url: generate_logo_team_path(@team), method: :post, data: { turbo: false } do |f| %>
              <div class="space-y-3">
                <%= label_tag :logo_description, "Describe your team logo", class: "block text-sm font-medium text-gray-900" %>
                <%= text_area_tag :logo_description, "",
                    placeholder: "e.g. A toddler with a hat on and large sunglasses held in a handsfree baby harness",
                    rows: 3,
                    class: "block w-full rounded-xl border border-gray-200 bg-white px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 sm:text-sm" %>
                <%= f.submit "Generate logo",
                    class: "flex w-full justify-center rounded-xl bg-emerald-600 px-3 py-2 text-sm font-semibold text-white hover:bg-emerald-500 cursor-pointer transition-colors",
                    data: { turbo_submits_with: "Please wait, generating your logo..." } %>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <%# Team jersey %>
      <div class="bg-white rounded-2xl border border-gray-200 p-6 mb-6">
        <p class="text-xs text-gray-400 uppercase tracking-wider mb-4">Team jersey</p>

        <% if @team.jersey.attached? %>
          <div class="flex flex-col items-center mb-4">
            <%= image_tag @team.jersey, class: "w-24 h-24 rounded-xl object-cover border border-gray-200" %>
            <p class="text-xs text-gray-400 mt-2">Current jersey</p>
          </div>
        <% else %>
          <p class="text-sm text-gray-400 mb-4">No <%= @team.name %> jersey present.</p>
        <% end %>

        <div class="space-y-4">
          <div>
            <p class="text-sm font-medium text-gray-900 mb-2">Upload a jersey</p>
            <%= form_with url: upload_jersey_team_path(@team), method: :patch, multipart: true, data: { turbo: false } do |f| %>
              <div class="space-y-3">
                <%= f.file_field :jersey, accept: "image/*",
                    class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-medium file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100 cursor-pointer" %>
                <%= f.submit "Upload jersey",
                    class: "flex w-full justify-center rounded-xl bg-emerald-600 px-3 py-2 text-sm font-semibold text-white hover:bg-emerald-500 cursor-pointer transition-colors" %>
              </div>
            <% end %>
          </div>

          <div class="border-t border-gray-100 pt-4">
            <p class="text-sm font-medium text-gray-900 mb-2">Generate a jersey with AI</p>
            <% if @team.logo.attached? %>
              <p class="text-xs text-gray-400 mb-3">Will use your current logo as a colour and style reference.</p>
              <%= form_with url: generate_jersey_team_path(@team), method: :post, data: { turbo: false } do |f| %>
                <div class="space-y-3">
                  <%= label_tag :jersey_description, "Describe your team jersey (optional)", class: "block text-sm font-medium text-gray-900" %>
                  <%= text_area_tag :jersey_description, "",
                      placeholder: "e.g. Dark navy with gold trim and a lightning bolt down the sleeve",
                      rows: 3,
                      class: "block w-full rounded-xl border border-gray-200 bg-white px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 sm:text-sm" %>
                  <%= f.submit "Generate jersey with AI",
                      class: "flex w-full justify-center rounded-xl bg-emerald-600 px-3 py-2 text-sm font-semibold text-white hover:bg-emerald-500 cursor-pointer transition-colors",
                      data: { turbo_submits_with: "Please wait, generating your jersey..." } %>
                </div>
              <% end %>
            <% else %>
              <p class="text-xs text-gray-400">Generate or upload a logo first — it will be used as a reference for the jersey.</p>
            <% end %>
          </div>
        </div>
      </div>

    <% else %>

      <div class="bg-white rounded-2xl border border-gray-200 p-8 text-center">
        <p class="text-sm text-gray-500">You do not have permission to edit this team.</p>
      </div>

    <% end %>

  </div>
</div>

<%# Fixed bottom nav bar %>
<div class="fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-gray-200 px-6 py-4">
  <div class="mx-auto max-w-2xl flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-center">
    <%= link_to team_path(@team), class: "w-full sm:w-auto text-center rounded-xl px-4 py-2.5 text-sm font-medium bg-gray-100 text-gray-900 hover:bg-gray-200 transition-colors" do %>
      Back to team
    <% end %>
  </div>
</div>
