<div class="min-h-screen flex items-start justify-center pt-16 p-8 pb-32">
  <div class="w-full max-w-2xl">

    <h1 class="text-2xl font-bold text-gray-900 font-barlow text-center mb-6">
      Edit <%= resource_name.to_s.humanize %>
    </h1>

    <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, multipart: true }) do |f| %>

      <%= f.error_notification wrapper_html: { class: "rounded-2xl bg-red-50 border border-red-200 px-5 py-4 text-sm text-red-700 mb-6" } %>

      <%# Profile photo %>
      <div class="bg-white rounded-2xl border border-gray-200 p-6 mb-6">
        <p class="text-xs text-gray-400 uppercase tracking-wider mb-4">Profile photo</p>

        <% if resource.avatar.attached? && resource.avatar.blob.persisted? %>
          <div class="flex flex-col items-center mb-4">
            <%= image_tag resource.avatar, class: "w-24 h-24 rounded-full object-cover border border-gray-200" %>
            <p class="text-xs text-gray-400 mt-2">Current profile picture</p>
          </div>
        <% end %>

        <%= f.input :avatar,
            as: :file,
            label: "Upload new photo",
            label_html: { class: "block text-sm font-medium text-gray-900" },
            input_html: { class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-medium file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100 cursor-pointer" },
            wrapper_html: { class: "space-y-1" } %>
      </div>

      <%# Account details %>
      <div class="bg-white rounded-2xl border border-gray-200 p-6 mb-6">
        <p class="text-xs text-gray-400 uppercase tracking-wider mb-4">Account details</p>
        <div class="space-y-4">
          <%= f.input :email,
              required: true,
              autofocus: true,
              label_html: { class: "block text-sm font-medium text-gray-900" },
              input_html: { class: "block w-full rounded-xl border border-gray-200 bg-white px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 sm:text-sm" },
              wrapper_html: { class: "space-y-1" } %>

          <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
            <p class="text-xs text-amber-600 bg-amber-50 border border-amber-200 rounded-xl px-4 py-3">
              Currently waiting confirmation for: <span class="font-medium"><%= resource.unconfirmed_email %></span>
            </p>
          <% end %>
        </div>
      </div>

      <%# Change password %>
      <div class="bg-white rounded-2xl border border-gray-200 p-6 mb-6">
        <p class="text-xs text-gray-400 uppercase tracking-wider mb-4">Change password</p>
        <div class="space-y-4">
          <%= f.input :password,
              hint: "Leave blank to keep your current password",
              required: false,
              input_html: { autocomplete: "new-password", class: "block w-full rounded-xl border border-gray-200 bg-white px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 sm:text-sm" },
              label_html: { class: "block text-sm font-medium text-gray-900" },
              hint_html: { class: "text-xs text-gray-400 mt-1" },
              wrapper_html: { class: "space-y-1" } %>
          <%= f.input :password_confirmation,
              required: false,
              input_html: { autocomplete: "new-password", class: "block w-full rounded-xl border border-gray-200 bg-white px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 sm:text-sm" },
              label_html: { class: "block text-sm font-medium text-gray-900" },
              wrapper_html: { class: "space-y-1" } %>
        </div>
      </div>

      <%= f.button :submit, "Update",
          class: "flex w-full justify-center rounded-xl bg-emerald-600 px-3 py-2 text-sm font-semibold text-white hover:bg-emerald-500 cursor-pointer transition-colors mb-6" %>

    <% end %>

    <%# Cancel account %>
    <div class="bg-white rounded-2xl border border-red-100 p-6 mb-6">
      <p class="text-xs text-gray-400 uppercase tracking-wider mb-1">Danger zone</p>
      <p class="text-sm text-gray-500 mb-4">Unhappy? You can permanently delete your account.</p>
      <%= button_to "Cancel my account",
          registration_path(resource_name),
          method: :delete,
          class: "flex w-full justify-center rounded-xl bg-red-500 px-3 py-2 text-sm font-semibold text-white hover:bg-red-600 cursor-pointer transition-colors",
          data: { turbo_confirm: "Are you sure?" } %>
    </div>

  </div>
</div>

<%# Fixed bottom nav bar %>
<div class="fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-gray-200 px-6 py-4">
  <div class="mx-auto max-w-2xl flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-center">
    <%= link_to :back, class: "w-full sm:w-auto text-center rounded-xl px-4 py-2.5 text-sm font-medium bg-gray-100 text-gray-900 hover:bg-gray-200 transition-colors" do %>
      Back
    <% end %>
  </div>
</div>
