<div class="container mx-auto px-4 py-4">
</div>
<div class="container mx-auto px-4 py-4">

  <h2 class="font-bold text-2xl">Next Game</h1>
  <h2 class="font-bold text-2xl mb-6">Next Game</h1>
  <%= render "/shared/matchcard" %>
  <h2 class="font-bold text-2xl mt-6">Competition Standings</h1>
  <%= render "/shared/standingstable" %>
    <%= link_to "Create New Competition", new_admin_competition_path if current_user&.is_admin? %>
  <h2 class="font-bold text-2xl mb-2">Competition Statistics</h1>
    <ul class="grid grid-cols-6 text-left w-full mb-4">
      <li class="hover:font-bold">Attack</li>
      <li class="hover:font-bold">Defence</li>
    </ul>

  <%= render "/shared/statscard" %>

</div>

<%= @competitions.each do |comp| %>
  <div class="divide-y divide-gray-200 overflow-hidden rounded-lg bg-red shadow-sm m-6">
    <div class="px-4 py-5 sm:px-6">
      <h3 class="text-lg font-medium leading-6 text-gray-900"><%= link_to comp.name, competition_path(comp) %></h3>
      <p class="mt-1 max-w-2xl text-sm text-gray-500"><%= comp.sport %></p>
    </div>
  </div>
<% end %>
